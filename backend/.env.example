# Application
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/opportunity_radar

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Scheduler
SCHEDULER_ENABLED=true
PIPELINE_INTERVAL_MINUTES=30

# Trial (self-serve register)
TRIAL_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:4200
