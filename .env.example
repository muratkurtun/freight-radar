# Copy to .env and edit as needed. docker-compose picks this up automatically.
# This file covers only the values that the compose file exposes as
# overrides; the backend's own .env (backend/.env) is used for non-compose
# local runs.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opportunity_radar
POSTGRES_PORT=5432

# --- Backend auth ---
# Any random string is fine for local. Do NOT reuse in any other environment.
JWT_SECRET=dev-only-change-me

# --- LLM (OpenAI) ---
# Leave empty to disable LLM calls locally; LlmVerifier short-circuits and
# the pipeline still collects raw items (signals just won't be detected).
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Scheduler ---
# Default OFF in local so uvicorn --reload doesn't keep firing pipeline ticks.
# Set to "true" to test the scheduler; use POST /pipeline/run for one-shot.
SCHEDULER_ENABLED=false
PIPELINE_INTERVAL_MINUTES=60

# --- Trial ---
TRIAL_DAYS=7
